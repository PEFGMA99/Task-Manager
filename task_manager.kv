<WindowManager>:
    Task_sreen:
        name: "task_screen"
    adding_task:
        name: "add_task"

<Task_sreen>:
    MDFloatLayout:
        MDCard:
            size_hint: 0.95, 0.85
            style: "elevated"
            pos_hint: {"center_x": 0.5, "center_y": 0.48}   
            ScrollView:
                do_scroll_x: False
                MDBoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    id: task

        # Fixed: Removed conflicting 'text' property from MDIconButton
        MDIconButton:
            icon: "theme-light-dark"
            pos_hint: {"center_x": 0.9, "center_y": 0.1}
            md_bg_color: "orange"
            on_press: app.switch()
        MDFillRoundFlatIconButton:
            icon:"update"
            text:"refresh"
            on_press: root.display()
             

        # Note: MDFillRoundFlatIconButton used for text + icon
        MDFillRoundFlatIconButton:
            text: "add_task"
            icon: "plus"
            pos_hint: {"center_x": 0.07, "center_y": 0.95}
            on_press: root.manager.current = "add_task"

<adding_task>:
    FloatLayout:
        MDLabel:
            text:""
            theme_text_color:"Custom"
            text_color:"red"
            id:not_empty
            pos_hint:{"center_x":0.87,"center_y":0.9}
            font_size:"30dp"

        MDFillRoundFlatIconButton:
            text:"back"
            icon:"arrow-left-bold"
            on_press:root.manager.current="task_screen"
        MDFillRoundFlatIconButton:
            icon:"arrow-up-bold"
            text:"save"
            pos_hint:{"center_x":0.9,"center_y":0.05}
            on_release:root.write()
        MDCard:
            size_hint: 0.9, 0.7
            pos_hint: {"center_x": 0.5, "center_y": 0.45} 
            # Added a layout inside MDCard so MDTextField scales and behaves properly
            MDFloatLayout:
                MDTextField:
                    helper_text: "Enter your Task here"
                    pos_hint: {"center_x": 0.5, "center_y": 0.49}
                    multiline: True
                    mode: "rectangle"
                    size_hint: 0.8, 0.5
                    id:new_task
        